# انسخ هذا الملف باسم .env وعبّي القيم

# توكن البوت من https://discord.com/developers/applications
DISCORD_TOKEN=

# Client ID (Application ID) لنفس البوت
CLIENT_ID=

# ID السيرفر (Guild ID) - فعّل Developer Mode بديسكورد ثم يمين كلك على السيرفر > Copy Server ID
GUILD_ID=

# ID روم سجل التذاكر (ticket-log) - يمين كلك على الروم > Copy Channel ID
TICKET_LOG_CHANNEL_ID=

# ID روم لوق Ticket Tool للقطاعات الثانوية (Store, Justice, Health, Citation...) - للأمر /تقرير-تذاكر-ثانوية
SECONDARY_TICKET_LOG_CHANNEL_ID=

# IDs رتب الدعم/الإدارة (كل الرتب اللي فريقكم يستخدمها)، مفصولة بفواصل بدون مسافة
# مثال: SUPPORT_ROLE_IDS=111111111111111111,222222222222222222,333333333333333333
# اختياري: لو تركته فاضي، البوت يحسب أي شخص يقفل تذكرة حتى لو مب إداري
SUPPORT_ROLE_IDS=

# ID روم سجل السحب اليدوي (للأمر /تقرير-سحب-يدوي) - يمين كلك على الروم > Copy Channel ID
PULL_LOG_CHANNEL_ID=

# ID روم لوق الصوت التلقائي من Wicks (انضمام/مغادرة/نقل) - للأمر /تقرير-حضور
VOICE_LOG_CHANNEL_ID=

# IDs مستخدمين/بوتات نتجاهلها كلياً بلوق الصوت (مفصولة بفواصل بدون مسافة)
IGNORED_USER_IDS=

# ==================== ميزات المراقبة اللحظية (اختيارية) ====================
# بوتنا يحتاج صلاحية "Move Members" بالسيرفر عشان أغلب هذي الميزات

# --- إرجاع تلقائي لعضو مسحوب لروم Waiting لو صار لحاله بدون إداري ---
AUTO_RETURN_ENABLED=0
WAITING_ROOM_CHANNEL_ID=
AUTO_RETURN_MINUTES=15

# روم يستقبل تنبيهات "لعبة مخالفة" و"إرجاع للويتنق" (اختياري)
ALERTS_CHANNEL_ID=

# --- إرسال تلقائي للتقرير الشامل (كصورة بهوية السيرفر) كل يوم جمعة ---
AUTO_REPORT_ENABLED=0
AUTO_REPORT_CHANNEL_ID=
AUTO_REPORT_HOUR=12

# --- نقل الإداري لروم بريك (بدل الفصل) لو يلعب لعبة غير مسموحة وقت تواجده بروم الدعم ---
GAME_MONITOR_ENABLED=0
# أسماء اللعبة المسموحة زي ما تطلع بديسكورد (أكثر من اسم مفصولة بفواصل، لأن اسم الـ Rich Presence يتغير أحياناً)
# مثال: ALLOWED_GAME_NAME=Grand Theft Auto V,FiveM,E9 STORE
ALLOWED_GAME_NAME=Grand Theft Auto V
GAME_MONITOR_GRACE_MINUTES=3
# IDs رومات البريك (يختار الأقل ازدحام تلقائياً) - مفصولة بفواصل بدون مسافة
BREAK_ROOM_CHANNEL_IDS=

# ==================== تنبيه الويتنق + السحب بالقائمة المنسدلة ====================
# لما أي عضو (إداري أو عادي) يدخل روم الويتنق، يرسل البوت تنبيه فيه قائمة منسدلة
# لسحبه مباشرة لأي روم سبورت، ويسجل مين سحبه بدقة + السبب/الحل + مدة الجلسة بنفس الرسالة
WAITING_ALERT_ENABLED=0
# الروم اللي ينرسل فيه التنبيه (لو فاضي يرجع يستخدم ALERTS_CHANNEL_ID)
WAITING_ALERT_CHANNEL_ID=
# IDs رومات السبورت (بالترتيب يلي بيطلعون بالقائمة 1..10) - مفصولة بفواصل بدون مسافة
SUPPORT_ROOM_CHANNEL_IDS=

# ==================== تصحيح أخطاء (اختياري، للتشخيص فقط) ====================
DEBUG_TICKETS=0
DEBUG_VOICE_USER_ID=

# --- هوية السيرفر بصورة التقرير الشامل (اختياري) ---
# اسم السيرفر اللي يطلع فوق التقرير وتحته
BRAND_NAME=
# اللون الأساسي (hex)، مثال: #e2203a
BRAND_COLOR=
# مسار شعار السيرفر نسبةً لمجلد البوت، مثال: assets/logo/my-logo.png
# لو تركته فاضي، يطلع شعار تذكرة افتراضي بلون السيرفر
BRAND_LOGO=
